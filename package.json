{
  "name": "openapi-to-trpc-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deps": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "build": "vp run --filter ./packages/openapi-to-trpc build",
    "check": "vp fmt --check && vp run -r check && pnpm lint",
    "fix": "vp fmt && vp run -r check --fix && markdownlint-cli2 --fix && textlint --fix --ignore-path .gitignore '**/*.md'",
    "lint": "pnpm lint:md && pnpm lint:text && pnpm lint:spell && pnpm lint:secret && pnpm lint:actions",
    "lint:md": "markdownlint-cli2",
    "lint:text": "textlint --ignore-path .gitignore '**/*.md'",
    "lint:spell": "cspell --no-progress --dot '**'",
    "lint:secret": "secretlint '**/*'",
    "lint:actions": "node scripts/actionlint.ts -color && node scripts/zizmor.ts .github/workflows",
    "test": "vp run --filter ./packages/openapi-to-trpc --filter ./test test"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@textlint-rule/textlint-rule-no-unmatched-pair": "2.0.4",
    "cspell": "10.3.3",
    "markdownlint-cli2": "0.23.2",
    "secretlint": "13.0.5",
    "textlint": "15.8.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-no-todo": "2.0.1",
    "textlint-rule-terminology": "5.2.16",
    "vite-plus": "0.3.1"
  },
  "packageManager": "pnpm@11.27.0"
}
