{
  "name": "openapi-to-trpc",
  "version": "0.2.0",
  "description": "OpenAPI/TypeSpec to tRPC code generator",
  "keywords": [
    "codegen",
    "openapi",
    "trpc",
    "typespec"
  ],
  "homepage": "https://github.com/nakita628/openapi-to-trpc",
  "bugs": {
    "url": "https://github.com/nakita628/openapi-to-trpc/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakita628/openapi-to-trpc.git",
    "directory": "packages/openapi-to-trpc"
  },
  "bin": {
    "openapi-to-trpc": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.6",
    "effect": "^4.0.6",
    "oas-truth": "^0.5.1",
    "oxfmt": "^0.74.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
